    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Lang.Avalonia.Analysis" Version="12.1.0.1" />
    <PackageReference Include="Lang.Avalonia.Resx" Version="12.1.0.1" PrivateAssets="all"/>
    
    
    
   
