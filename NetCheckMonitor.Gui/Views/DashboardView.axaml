<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetCheckMonitor.Gui.ViewModels"
             x:Class="NetCheckMonitor.Gui.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="NetCheckMonitor"
                FontSize="24"
                FontWeight="Bold"/>

            <TextBlock
                Grid.Column="1"
                Text="● Idle"
                VerticalAlignment="Center"/>

        </Grid>

        <!-- Monitor Settings -->
        <GroupBox
            Grid.Row="2"
            Header="Monitor Settings"
            MinHeight="120">

            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>                
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Host -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Host:"
                    VerticalAlignment="Center"/>

                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding Host}"
                    PlaceholderText="8.8.8.8 或 google.com"/>

                <!-- Interval -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="3"
                    Text="Interval:"
                    VerticalAlignment="Center"/>

                <NumericUpDown
                    Grid.Row="0"
                    Grid.Column="4"
                    Value="{Binding Interval}"
                    Minimum="100"
                    Maximum="60000"
                    Increment="100"/>

                <!-- Timeout -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="6"
                    Text="Timeout:"
                    VerticalAlignment="Center"/>

                <NumericUpDown
                    Grid.Row="0"
                    Grid.Column="7"
                    Value="{Binding Timeout}"
                    Minimum="100"
                    Maximum="60000"
                    Increment="100"/>

                <!-- Buttons -->
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="9"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">

                    <Button Width="100">
                        Start
                    </Button>

                    <Button Width="100">
                        Stop
                    </Button>

                </StackPanel>

            </Grid>

        </GroupBox>
        <!-- System Information -->
        <GroupBox
            Grid.Row="4"
            Header="System Information"
            MinHeight="170">

            <Grid Margin="10"
                  ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,12,6"
                    FontWeight="SemiBold"
                    Text="Host Name:"/>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,6"
                    Text="{Binding SystemInformation.Computer.HostName}"/>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,12,6"
                    FontWeight="SemiBold"
                    Text="Manufacturer:"/>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,6"
                    Text="{Binding SystemInformation.Computer.Manufacturer}"/>

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,12,6"
                    FontWeight="SemiBold"
                    Text="Model:"/>

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,0,0,6"
                    Text="{Binding SystemInformation.Computer.Model}"/>

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,0,12,6"
                    FontWeight="SemiBold"
                    Text="Operating System:"/>

                <StackPanel
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,0,0,6"
                    Orientation="Horizontal"
                    Spacing="6">

                    <TextBlock
                        Text="{Binding SystemInformation.OperatingSystem.Name}"/>

                    <TextBlock
                        Text="{Binding SystemInformation.OperatingSystem.Version}"/>
                </StackPanel>

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    FontWeight="SemiBold"
                    Text="Processor:"/>

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Text="{Binding SystemInformation.Processor.Model}"/>

            </Grid>
        </GroupBox>

        <!-- Results -->
        <GroupBox
            Grid.Row="6"
            Header="Results"
            MinHeight="250">

            <DataGrid
                ItemsSource="{Binding Results}"
                Margin="10"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                GridLinesVisibility="All">

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Header="Time"
                        Binding="{ReflectionBinding Timestamp}"
                        Width="Auto"/>

                    <DataGridTextColumn
                        Header="Host"
                        Binding="{ReflectionBinding Host}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Status"
                        Binding="{ReflectionBinding Status}"
                        Width="Auto"/>

                    <DataGridTextColumn
                        Header="RTT"
                        Binding="{ReflectionBinding RoundTripTime}"
                        Width="Auto"/>
                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>
    </Grid>
</UserControl>